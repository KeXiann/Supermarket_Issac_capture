--- /dev/null
+++ b/gear_sonic/utils/teleop/simulation_stop.py
@@ -0,0 +1,72 @@
+"""File handshake for ending one local simulation before stopping its policy.
+
+Only enabled by the Isaac launcher; independent of DDS and physical robots.
+The acknowledgement means no further physics steps will be taken, not that a
+free-base robot can balance after its policy has disconnected.
+"""
+import json
+import os
+from pathlib import Path
+import time
+import uuid
+
+
+def atomic_json(path, data):
+    path = Path(path)
+    temporary = path.with_name(f"{path.name}.{os.getpid()}.{uuid.uuid4().hex}.tmp")
+    try:
+        temporary.write_text(json.dumps(data, indent=2))
+        temporary.replace(path)
+    finally:
+        temporary.unlink(missing_ok=True)
+
+
+def acknowledgement_path(path):
+    return Path(path).with_name(Path(path).name + ".ack.json")
+
+
+class SimulationStopGate:
+    def __init__(self, path):
+        self.path = Path(path)
+        self.started = time.monotonic()
+        self.token = None
+        self.request = None
+
+    def requested(self):
+        if self.request is not None:
+            return True
+        try:
+            data = json.loads(self.path.read_text())
+            stamp = float(data["requested_monotonic"])
+            if not self.started <= stamp <= time.monotonic() or not isinstance(data["token"], str):
+                return False
+            self.token = data["token"]
+            self.request = data
+            return True
+        except (FileNotFoundError, ValueError, KeyError, TypeError):
+            return False
+
+    def acknowledge(self, sim_time):
+        if self.request is None:
+            raise RuntimeError("no simulation stop request to acknowledge")
+        atomic_json(acknowledgement_path(self.path), {
+            "token": self.token, "physics_stopped": True,
+            "simulation_seconds": sim_time, "bridge_pid": os.getpid(),
+            "acknowledged_monotonic": time.monotonic(),
+        })
+
+
+def request_simulation_stop(path, reason, timeout=3.):
+    token = uuid.uuid4().hex
+    atomic_json(path, {"token": token, "reason": reason,
+                       "requested_monotonic": time.monotonic()})
+    deadline = time.monotonic()+timeout
+    while time.monotonic() < deadline:
+        try:
+            ack = json.loads(acknowledgement_path(path).read_text())
+            if ack.get("token") == token and ack.get("physics_stopped") is True:
+                return True
+        except (FileNotFoundError, ValueError):
+            pass
+        time.sleep(.01)
+    return False
