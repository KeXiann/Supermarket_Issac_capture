+"""Exclusive PICO recording chords and durable single-episode boundaries.
+
+Only the local simulation launcher enables the file gate. Controller gestures
+match GR00T-2609: left grip + A toggles recording; left grip + B discards it.
+ABXY calibration and AX/BY mode gestures never count as recording gestures.
+"""
+import json
+import os
+from pathlib import Path
+import time
+import uuid
+
+
+class RecordingChords:
+    def __init__(self):
+        self.armed = True
+        self.released_at = None
+
+    def update(self, a, b, x, y, left_grip, *, now=None):
+        now = time.monotonic() if now is None else now
+        # Rearm only after A/B/X/Y are all released for 200 ms. Holding the
+        # grip is allowed; bouncing, mode switches, and ABXY cannot retrigger.
+        if not any((a, b, x, y)):
+            if self.released_at is None:
+                self.released_at = now
+            if now - self.released_at >= .2:
+                self.armed = True
+            return None
+        self.released_at = None
+        if not self.armed:
+            return None
+        self.armed = False
+        if left_grip <= .5 or x or y or (a and b):
+            return None
+        return 'toggle' if a else 'discard' if b else None
+
+
+class RecordingControl:
+    def __init__(self, path):
+        self.path = Path(path)
+        if self.path.exists():
+            raise FileExistsError(f'refusing to overwrite recording boundaries: {self.path}')
+        self.data = {'schema_version': 1, 'status': 'idle',
+                     'host_boot_id': Path('/proc/sys/kernel/random/boot_id').read_text().strip(),
+                     'clock': 'CLOCK_MONOTONIC nanoseconds; start inclusive, end exclusive',
+                     'start_monotonic_ns': None, 'end_monotonic_ns': None,
+                     'start_chord': 'left_grip>0.5 + A', 'stop_chord': 'left_grip>0.5 + A',
+                     'discard_chord': 'left_grip>0.5 + B', 'events': []}
+        self._write()
+
+    def _write(self):
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        temporary = self.path.with_name(f'{self.path.name}.{uuid.uuid4().hex}.tmp')
+        try:
+            with temporary.open('x') as stream:
+                json.dump(self.data, stream, indent=2)
+                stream.flush()
+                os.fsync(stream.fileno())
+            os.replace(temporary, self.path)
+            fd = os.open(self.path.parent, os.O_RDONLY | os.O_DIRECTORY)
+            try:
+                os.fsync(fd)
+            finally:
+                os.close(fd)
+        finally:
+            temporary.unlink(missing_ok=True)
+
+    def handle(self, event, *, pose_ready, now_ns=None, reason=None):
+        now_ns = time.monotonic_ns() if now_ns is None else int(now_ns)
+        status = self.data['status']
+        if status in ('stopped', 'discarded'):
+            return None
+        if event == 'toggle' and status == 'idle':
+            if not pose_ready:
+                print('[REC] NOT STARTED: calibrate ABXY, enter SONIC POSE with A+X, release buttons, then left grip + A.', flush=True)
+                return None
+            self.data['start_monotonic_ns'] = now_ns
+            self.data['status'] = 'recording'
+            result = 'started'
+        elif event == 'discard' and status == 'recording':
+            self.data['end_monotonic_ns'] = now_ns
+            self.data['status'] = 'discarded'
+            result = 'discarded'
+        elif event in ('toggle', 'finish') and status == 'recording':
+            if now_ns <= self.data['start_monotonic_ns']:
+                raise ValueError('recording stop must follow start')
+            self.data['end_monotonic_ns'] = now_ns
+            self.data['status'] = 'stopped'
+            result = 'stopped'
+        else:
+            return None
+        self.data['events'].append({'event': result, 'host_monotonic_ns': now_ns,
+                                    'reason': reason or event})
+        self._write()
+        notice = {'started': '>>> RECORDING STARTED <<<',
+                  'stopped': '>>> RECORDING STOPPED - SAVING; wait for [CAPTURE] complete <<<',
+                  'discarded': '>>> EPISODE DISCARDED — raw diagnostics retained <<<'}
+        print('[REC] ' + notice[result], flush=True)
+        return result
diff --git a/gear_sonic/utils/teleop/packet_recorder.py b/gear_sonic/utils/teleop/packet_recorder.py
new file mode 100644
--- /dev/null
+++ b/gear_sonic/utils/teleop/packet_recorder.py
@@ -0,0 +1,95 @@
+"""Bounded asynchronous recording of outgoing teleoperation packets.
+
+Compression and file writes never run on the control thread. Lost recording
+packets and writer errors are reported; they do not delay live commands.
+"""
+import json
+import os
+from pathlib import Path
+import queue
+import threading
+
+import numpy as np
+
+
+class PacketRecorder:
+    def __init__(self, directory, capacity=128):
+        self.directory = Path(directory)
+        self.directory.mkdir(parents=True, exist_ok=True)
+        self.queue = queue.Queue(maxsize=capacity)
+        self.dropped = 0
+        self.written = 0
+        self.error = None
+        self.closed = False
+        self.submitted = 0
+        self.thread = threading.Thread(target=self._run, name="pico-packet-writer", daemon=True)
+        self.thread.start()
+
+    def submit(self, index, packet):
+        if self.closed:
+            raise RuntimeError("packet recorder is closed")
+        self.submitted += 1
+        if self.error is not None:
+            self.dropped += 1
+            return False
+        data = {key: np.asarray(value).copy() for key, value in packet.items()}
+        try:
+            self.queue.put_nowait((index, data))
+            return True
+        except queue.Full:
+            self.dropped += 1
+            if self.dropped <= 3 or self.dropped % 50 == 0:
+                print(f"[PoseRecording] backlog: skipped {self.dropped} recording packets; live stream continues", flush=True)
+            return False
+
+    def _run(self):
+        while True:
+            item = self.queue.get()
+            try:
+                if item is None:
+                    return
+                index, packet = item
+                if self.error is None:
+                    destination = self.directory/f"pose_{index:06d}.npz"
+                    temporary = destination.with_suffix(".npz.tmp")
+                    with temporary.open("xb") as stream:
+                        np.savez_compressed(stream, **packet)
+                        stream.flush()
+                        os.fsync(stream.fileno())
+                    # link is atomic and never replaces an older packet.
+                    os.link(temporary, destination)
+                    temporary.unlink()
+                    self.written += 1
+            except Exception as exc:
+                self.error = str(exc)
+                print(f"[PoseRecording] write failed: {exc}", flush=True)
+            finally:
+                self.queue.task_done()
+
+    def close(self):
+        if self.closed:
+            if self.error is not None:
+                raise RuntimeError(f"packet recording failed: {self.error}")
+            return
+        self.closed = True
+        self.queue.put(None)
+        # Normal stop must drain every accepted packet. A timeout followed by
+        # daemon process exit used to silently abandon queued recordings.
+        self.thread.join()
+        status = {"written": self.written, "dropped": self.dropped,
+                  "submitted": self.submitted, "closed": True,
+                  "error": self.error, "writer_still_running": self.thread.is_alive()}
+        temporary = self.directory/"recording_status.json.tmp"
+        with temporary.open("x") as stream:
+            json.dump(status, stream, indent=2)
+            stream.flush()
+            os.fsync(stream.fileno())
+        temporary.replace(self.directory/"recording_status.json")
+        fd = os.open(str(self.directory), os.O_RDONLY | os.O_DIRECTORY)
+        try:
+            os.fsync(fd)
+        finally:
+            os.close(fd)
+        print(f"[PoseRecording] {status}", flush=True)
+        if self.error is not None:
+            raise RuntimeError(f"packet recording failed: {self.error}")
diff --git a/gear_sonic/utils/teleop/revo2_hand_control.py b/gear_sonic/utils/teleop/revo2_hand_control.py
new file mode 100644
--- /dev/null
+++ b/gear_sonic/utils/teleop/revo2_hand_control.py
@@ -0,0 +1,93 @@
+"""Continuous controller grasp synergies over SONIC's existing Dex3 wire format.
+
+The seven wire slots keep Dex3 semantics (thumb 3, index 2, middle 2).
+They are not Revo2 motor indices. Revo2 has six independently driven motors
+and five mimic joints. Measured feedback uses the inverse map, including the
+mirrored Dex3 signs, because SONIC limits each command relative to feedback.
+"""
+import numpy as np
+
+ACTIVE_SUFFIXES = (
+    "thumb_metacarpal_joint", "thumb_proximal_joint", "index_proximal_joint",
+    "middle_proximal_joint", "ring_proximal_joint", "pinky_proximal_joint",
+)
+# Dex3's first thumb slot is the opposition axis.  The upstream G1 hand
+# profile uses 0.5 rad for opposition; it is independent of thumb flexion.
+DEX3_THUMB_OPPOSITION = .50
+# The user-requested open pose is the pinned USD's authored, opposed thumb
+# (about 87 degrees), rather than the adapter's zero/metacarpal-flat reset.
+# Recovered from the left/right joint frames in aa93b9064486, in radians.
+THUMB_OPPOSITION = {True: 1.5153632437698297, False: 1.512326420471389}
+REVO2_THUMB_OPPOSITION = THUMB_OPPOSITION[True]
+REVO2_CLOSED = np.array([REVO2_THUMB_OPPOSITION, 0.95, 1.30, 1.30, 1.30, 1.30])
+REVO2_OPEN = {
+    side: np.array([angle, 0., 0., 0., 0., 0.])
+    for side, angle in THUMB_OPPOSITION.items()
+}
+DEX3_CLOSED = np.array([DEX3_THUMB_OPPOSITION, .70, .70, -1.0, -1.5, -1.0, -1.5])
+DISTAL_RATIOS = np.array([1., 1.155, 1.155, 1.155, 1.155])
+
+
+def revo2_full_target(active_target, measured_active):
+    """Six commanded motors plus five compliant measured-parent followers.
+
+    The distal joints follow actual proximal positions, not their requested
+    closure. Otherwise a blocked proximal finger still curls its tip to the
+    full closed angle and can eject a grasped object. This bounded drive model
+    approximates coupling; it is not a hard mimic constraint or tendon model.
+    """
+    active_target = np.asarray(active_target, dtype=np.float64)
+    measured_active = np.asarray(measured_active, dtype=np.float64)
+    distal = np.maximum(measured_active[1:], 0.) * DISTAL_RATIOS
+    return np.concatenate((active_target, distal))
+
+
+def controller_hand_command(trigger, grip, is_left=True):
+    """Main trigger closes all five fingers; side grip never moves the hand.
+
+    Keep the grip argument for existing live/replay call sites and raw input
+    logging. Side grip is reserved for recording chords, not grasp actuation.
+    """
+    trigger = np.clip(trigger, 0., 1.)
+    # Ignore resting sensor noise without turning analog input into a button.
+    closure = np.clip((trigger - .04) / .96, 0., 1.)
+    # Keep the thumb opposed when released and gripping. Flexion
+    # remains analog. This is a driven joint pose, not a mesh rotation.
+    out = DEX3_CLOSED * np.array([1., closure, closure, closure, closure, closure, closure])
+    return (out if is_left else -out).astype(np.float32)
+
+
+def dex3_to_revo2(command, is_left=True):
+    """Convert signed Dex3 slots to six Revo2 motor targets.
+
+    Dex3 thumb_0 is opposition (Revo2 metacarpal); thumb_1/2 are flexion
+    (Revo2 proximal).  Keeping these channels separate prevents a pinch from
+    rotating the whole thumb into the palm while it flexes.
+    """
+    q = np.asarray(command, dtype=np.float64)
+    thumb_opposition = np.clip(np.abs(q[0]) / DEX3_THUMB_OPPOSITION, 0., 1.)
+    thumb_flexion = np.clip(np.mean(np.abs(q[1:3])) / .70, 0., 1.)
+    index = np.clip(np.mean(np.abs(q[3:5]) / [1., 1.5]), 0., 1.)
+    middle = np.clip(np.mean(np.abs(q[5:7]) / [1., 1.5]), 0., 1.)
+    scale = REVO2_CLOSED.copy()
+    scale[0] = THUMB_OPPOSITION[is_left]
+    return scale * [thumb_opposition, thumb_flexion, index, middle, middle, middle]
+
+
+def revo2_to_dex3(positions, is_left=True, *, velocity=False):
+    """Map measured six-motor state back to the signed SONIC wire convention.
+
+    Thumb opposition and proximal flexion are mapped to Dex3 thumb_0 and
+    thumb_1/2 respectively. Middle proximal remains the representative
+    measurement for the middle/ring/pinky synergy; all physical measurements
+    are still recorded separately by the Bridge.
+    Velocities use only the derivative of the position map. The explicit
+    velocity flag also keeps any future position offset out of velocity data.
+    """
+    # Use a linear map for both position and velocity. In particular, avoid a
+    # zero span on the opposition motor (its open and grasp targets coincide).
+    scale = REVO2_CLOSED.copy()
+    scale[0] = THUMB_OPPOSITION[is_left]
+    q = np.asarray(positions, dtype=np.float64) / scale
+    out = DEX3_CLOSED * [q[0], q[1], q[1], q[2], q[2], q[3], q[3]]
+    return out if is_left else -out
diff --git a/gear_sonic/utils/teleop/simulation_stop.py b/gear_sonic/utils/teleop/simulation_stop.py
