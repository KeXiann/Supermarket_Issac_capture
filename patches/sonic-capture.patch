--- /dev/null
+++ b/gear_sonic/utils/teleop/body_walk.py
@@ -0,0 +1,108 @@
+"""Measured human translation -> SONIC planner commands (OpenXR coordinates).
+
+This does not drive joints or move the simulated base. SONIC still plans and
+executes all steps. Heading is the headset's horizontal facing at calibration;
+looking around afterwards does not steer the robot. Input is metres/seconds.
+"""
+from collections import deque
+import time
+
+import numpy as np
+from scipy.spatial.transform import Rotation
+
+
+class BodyWalk:
+    def __init__(self, max_speed=.5):
+        self.max_speed = max_speed
+        self.reset()
+
+    def reset(self, sample=None):
+        self.history = deque()
+        self.basis = None
+        self.velocity = np.zeros(2)
+        self.active = False
+        self.step_until = 0.
+        self.floor = None
+        self.reason = "not calibrated"
+        if sample is None:
+            return False
+        raw = np.asarray(sample.get("body_poses_np", []), dtype=float)
+        if raw.shape != (24, 7) or not np.isfinite(raw).all():
+            self.reason = "invalid body tracking"
+            return False
+        head = np.asarray(sample.get("headset_pose", []), dtype=float)
+        if head.shape != (7,) or not np.isfinite(head).all() or np.linalg.norm(head[3:]) < .5:
+            return False
+        # XRoboToolkit follows OpenXR: Y up, -Z forward, xyzw quaternion.
+        forward = Rotation.from_quat(head[3:]).apply([0., 0., -1.])[[0, 2]]
+        if np.linalg.norm(forward) < .5:
+            self.reason = "look horizontally to calibrate"
+            return False
+        forward /= np.linalg.norm(forward)
+        self.basis = np.array([forward, [forward[1], -forward[0]]])
+        self.floor = raw[[7, 8], 1].copy()
+        self.reason = "ready"
+        return True
+
+    def _stop(self, reason, clear=False):
+        self.velocity[:] = 0.
+        self.active = False
+        self.reason = reason
+        if clear:
+            self.history.clear()
+            self.step_until = 0.
+        return self.velocity.copy()
+
+    def update(self, sample, now=None):
+        now = time.monotonic() if now is None else now
+        if self.basis is None or sample is None:
+            return self._stop("not calibrated")
+        if now-float(sample.get("timestamp_monotonic", -np.inf)) > .2:
+            return self._stop("stale tracking", clear=True)
+        raw = np.asarray(sample.get("body_poses_np", []), dtype=float)
+        if raw.shape != (24, 7) or not np.isfinite(raw).all():
+            return self._stop("invalid tracking", clear=True)
+        stamp = int(sample.get("body_timestamp_ns", sample.get("timestamp_ns", 0)))
+        if stamp <= 0:
+            return self._stop("invalid timestamp", clear=True)
+        if self.history and stamp == self.history[-1][0]:
+            # Overall headset packets may advance while body tracking is frozen.
+            if now-self.history[-1][3] > .2:
+                return self._stop("frozen body tracking", clear=True)
+            return self.velocity.copy()
+        position = raw[0, [0, 2]].copy()
+        feet = raw[[7, 8], :3].copy()
+        dt = .05
+        if self.history:
+            dt = (stamp-self.history[-1][0])*1e-9
+            jump = np.linalg.norm(position-self.history[-1][1])
+            if dt <= 0 or dt > .25 or jump > max(.08, 2.*dt):
+                self._stop("tracking discontinuity", clear=True)
+                self.history.append((stamp, position, feet, now))
+                return self.velocity.copy()
+        self.history.append((stamp, position, feet, now))
+        while len(self.history) > 2 and (stamp-self.history[0][0])*1e-9 > .2:
+            self.history.popleft()
+        span = (stamp-self.history[0][0])*1e-9
+        if span < .10:
+            return self._stop("collecting velocity")
+        times = np.array([(item[0]-stamp)*1e-9 for item in self.history])
+        times -= times.mean()
+        positions = np.array([item[1] for item in self.history])
+        measured = self.basis @ (times @ positions / (times @ times))
+        # A torso lean with planted feet must not start a gait. Require a recent
+        # measured ankle lift or displacement; in-place stepping has no net speed.
+        foot_travel = np.linalg.norm(feet-self.history[0][2], axis=1).max()
+        lift = (raw[[7, 8], 1]-self.floor).max()
+        if foot_travel > .02 or lift > .015:
+            self.step_until = now+.3
+        speed = np.linalg.norm(measured)
+        threshold = .035 if self.active else .06
+        if speed < threshold or now > self.step_until:
+            return self._stop("standing")
+        self.active = True
+        target = measured * min(1., self.max_speed/max(speed, 1e-9))
+        alpha = 1.-np.exp(-min(dt, .1)/.10)
+        self.velocity += alpha*(target-self.velocity)
+        self.reason = "walking"
+        return self.velocity.copy()
